    {
      "name": "7. Chat",
      "description": "The chat itself runs over Socket.IO (see postman-guide.md, section 4). This loads a session's saved messages and the hand-off list for the Escalated tab.",
      "item": [
        {
          "name": "Chat transcript for a session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{session_id}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}",
                "messages"
              ]
            },
            "description": "Empty for a session that never talked to staff. After a chat (test-client.js or the Postman Socket.IO tabs), it lists every message, oldest first, with ID-like numbers shown as [hidden]."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const msgs = pm.response.json();",
                  "pm.test(\"Returns an array of messages\", () => pm.expect(msgs).to.be.an(\"array\"));",
                  "msgs.forEach(m => pm.test(\"No unmasked ID numbers\", () => pm.expect(m.text).not.to.match(/\\b(?=[A-Za-z0-9]*\\d)[A-Za-z0-9]{6,}\\b/)));",
                  "console.log(msgs.length + \" saved message(s)\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Hand-offs (Escalated tab)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/handoffs?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "handoffs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "What the console's Escalated to Staff Help tab loads: every session that asked for help, one row per session (latest request + count), live sessions first. Status waiting/active/resolved; grouped on screen by outcome."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.test(\"One row per session, at most 10\", () => {",
                  "  pm.expect(rows).to.be.an(\"array\");",
                  "  pm.expect(rows.length).to.be.at.most(10);",
                  "  pm.expect(new Set(rows.map(r => r.session_id)).size).to.eql(rows.length);",
                  "});",
                  "pm.test(\"Has data (run node seed.js if this fails)\", () => pm.expect(rows.length).to.be.above(0));",
                  "rows.forEach(r => pm.test(\"Valid row \" + r.session_id, () => {",
                  "  pm.expect([\"waiting\", \"active\", \"resolved\"]).to.include(r.status);",
                  "  pm.expect([\"in_progress\", \"submitted\", \"abandoned\", \"not_eligible\"]).to.include(r.outcome);",
                  "  pm.expect(r).not.to.have.any.keys(\"phone\", \"name\", \"passport_country\");",
                  "}));",
                  "console.log(rows.filter(r => r.source === \"live\").length + \" live, \" + rows.filter(r => r.source === \"synthetic\").length + \" demo\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "8. Hand-off demo (with Socket.IO)",
      "description": "Shows: handoff:request \u2192 saved in events \u2192 open queue \u2192 handoff:new (Friction Queue card) \u2192 insights:update \u2192 GET /api/handoffs (row in Pending: Waiting\u2026).\n\n1. Send **Start a session for the demo**.\n2. In a Socket.IO tab, send `join_session` and then `handoff:request` (the exact messages are in the Console, and in postman-guide.md \u00a74.4).\n3. Send **Check: the request reached the Escalated tab**.\n\nRunning the whole collection without step 2 is fine: the check is skipped, not failed.",
      "item": [
        {
          "name": "Start a session for the demo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "description": "Creates the session for the demo and saves it as {{session_id_demo}} (collection and global variable, so you can use it in Socket.IO messages). The Console prints the two Socket.IO messages to send next.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preferences\": {\n    \"wording\": \"standard\",\n    \"text_size\": \"large\",\n    \"language\": \"en\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const id = pm.response.json().session_id;",
                  "pm.collectionVariables.set(\"session_id_demo\", id);",
                  "pm.globals.set(\"session_id_demo\", id);   // so Socket.IO tabs can use {{session_id_demo}}",
                  "console.log(\"join_session:\", JSON.stringify({ session_id: id }));",
                  "console.log(\"handoff:request:\", JSON.stringify({ session_id: id, page_id: \"account.step3\",",
                  "  share: { step_no: 3, step_title: \"Scan your passport chip\", last_error: \"NFC_READ_FAILED\", failed_attempts: 2 } }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check: the request reached the Escalated tab",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/handoffs?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "handoffs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "What the Escalated tab loads after insights:update. Finds the demo session's row: status \"waiting\" until someone picks it up, \"active\" after Pick Up Chat, \"resolved\" after Resolve & Close."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const id = pm.collectionVariables.get(\"session_id_demo\");",
                  "const row = pm.response.json().find(r => r.session_id === id);",
                  "if (!row) {",
                  "  pm.test.skip(\"Row for \" + id + \" (send handoff:request in the Socket.IO tab first)\", () => {});",
                  "  console.log(\"No hand-off yet for\", id, \": send handoff:request, then this request again.\");",
                  "} else {",
                  "  pm.test(\"1. Saved: the request is in events (one row for this session)\", () => pm.expect(row.handoff_count).to.be.at.least(1));",
                  "  pm.test(\"Still in progress \u2192 Pending group\", () => pm.expect(row.outcome).to.eql(\"in_progress\"));",
                  "  pm.test(\"Step shown (step 3, Scan your passport chip)\", () => {",
                  "    pm.expect(row.step_no).to.eql(3);",
                  "    pm.expect(row.step_title).to.eql(\"Scan your passport chip\");",
                  "  });",
                  "  pm.test(\"Status is waiting, active or resolved\", () => pm.expect([\"waiting\", \"active\", \"resolved\"]).to.include(row.status));",
                  "  console.log(\"Escalated tab row:\", row.status, \"| step\", row.step_no, row.step_title, \"| error\", row.last_error, \"| live:\", row.source === \"live\");",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "session_id_2",
      "value": ""
    },
    {
      "key": "session_id_ai",
      "value": ""
    },
    {
      "key": "session_id_demo",
      "value": ""
    }
  ]
