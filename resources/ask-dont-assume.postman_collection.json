    {
      "name": "6. AI",
      "description": "Asks the AI through the backend. Works without the AI service too: you then get the safe fallback.",
      "item": [
        {
          "name": "Start a session in Chinese, simple wording",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preferences\": {\n    \"wording\": \"simple\",\n    \"text_size\": \"default\",\n    \"language\": \"zh\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"session_id_ai\", pm.response.json().session_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask a question on step 3",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/explain",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "explain"
              ]
            },
            "description": "The server adds the step text, verified_info, the last error and the session's language (zh) before calling the AI service. If the AI is down or slow, fallback is true.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id_ai}}\",\n  \"page_id\": \"account.step3\",\n  \"question\": \"Why won't my passport scan?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Has type, answer and fallback\", () => {",
                  "  pm.expect(b).to.have.keys(\"type\", \"answer\", \"fallback\", \"action\", \"value\");",
                  "  pm.expect(b.fallback).to.be.a(\"boolean\");",
                  "});",
                  "console.log(b.fallback ? \"Fallback (is the AI service running?)\" : \"AI answered: \" + b.answer);"
                ]
              }
            }
          ]
        },
        {
          "name": "Question on a non-journey page (rejected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/explain",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "explain"
              ]
            },
