    {
      "name": "3. Journey (run in order)",
      "description": "One applicant's journey: start, change a setting mid-journey, submit. The session ID is saved to the `session_id` variable automatically.",
      "item": [
        {
          "name": "Start session (tap 'Foreigner with e-passport')",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "description": "Creates one document in `sessions` with source `live` and outcome `in_progress`. Only preferences are sent; the server sets everything else.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preferences\": {\n    \"wording\": \"standard\",\n    \"text_size\": \"large\",\n    \"language\": \"en\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const id = pm.response.json().session_id;",
                  "pm.test(\"Returns a session_id\", () => pm.expect(id).to.match(/^s\\d+_\\d+$/));",
                  "pm.collectionVariables.set(\"session_id\", id);",
                  "console.log(\"session_id =\", id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Change wording to simple (mode bar)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{session_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}"
              ]
            },
            "description": "Updates `current_preferences`, which the AI answers in. The browser also sends a `wording_change:simple` event over Socket.IO.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_preferences\": {\n    \"wording\": \"simple\",\n    \"text_size\": \"large\",\n    \"language\": \"en\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "description": "Sets the session's outcome to `submitted`. The reference is shown on screen only, never stored.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Reference looks like APP-XXXXXX\", () => pm.expect(pm.response.json().reference).to.match(/^APP-[A-Z0-9]{6}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit again (rejected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "description": "A session can only be submitted once.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"session_not_active\", () => pm.expect(pm.response.json().error).to.eql(\"session_not_active\"));"
                ]
              }
            }
          ]
        }
      ]
    },
