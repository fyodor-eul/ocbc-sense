              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"s0_0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
