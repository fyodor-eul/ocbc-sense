              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id_2}}"
              ]
            },
            "description": "`submitted` can only be set by POST /api/applications.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"submitted\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"bad_outcome\", () => pm.expect(pm.response.json().error).to.eql(\"bad_outcome\"));"
                ]
              }
            }
          ]
        },
