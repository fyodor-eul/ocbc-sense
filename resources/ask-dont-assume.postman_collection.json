    {
      "name": "5. Validation (rejected requests)",
      "description": "Shows the backend refusing bad input.",
      "item": [
        {
          "name": "Unsupported language (Bahasa Indonesia)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "description": "Only en, zh and ms are allowed. Mongoose rejects anything else.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preferences\": {\n    \"language\": \"id\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"invalid_data names the field\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.error).to.eql(\"invalid_data\");",
                  "  pm.expect(b.fields).to.include(\"preferences.language\");",
                  "});"
                ]
              }
            }
          ]
        },
